<?xml version="1.0" encoding="UTF-8"?>

<!-- JavaFX Imports -->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- 
    Server Chat Application Layout
    ============================
    Main container for the server chat interface
    Controller: server.s.ServerController
    Styles: root-container class for base styling
-->
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="server.s.ServerController"
      styleClass="root-container">
    
    <!-- 
        Main Content Area
        ================
        Contains the server interface with message display and input controls
    -->
    <VBox styleClass="main-container" VBox.vgrow="ALWAYS" spacing="0">
        <!-- 
            Header Section

            Contains the server control button
        -->
        <HBox alignment="CENTER_LEFT" HBox.hgrow="NEVER" style="-fx-padding: 10;">
            <Button fx:id="serverControlButton" text="Start Server" styleClass="control-button"/>
        </HBox>

        <!-- 
            Message Display Area

            Scrollable container for server messages and chat
        -->
        <VBox VBox.vgrow="ALWAYS" style="-fx-padding: 10;">
            <ScrollPane fx:id="messageScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
                      styleClass="message-scroll-pane">
                <!-- 
                    Message Container
                    
                    Dynamically populated with server messages
                    Uses VBox for vertical message stacking
                -->
                <VBox fx:id="messageContainer" spacing="8" styleClass="message-container-vbox">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                </VBox>
            </ScrollPane>
        </VBox>

        <!-- 
            Message Input Area

            Contains controls for broadcasting messages to all clients
        -->
        <VBox HBox.hgrow="NEVER" style="-fx-padding: 10;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <!-- Message text input -->
                <TextField fx:id="messageField" HBox.hgrow="ALWAYS"
                         promptText="Type your message..."
                         styleClass="message-input"/>
                <!-- Emoji picker button -->
                <Button fx:id="emojiPickerButton" text="🙂" styleClass="emoji-picker-button" focusTraversable="false"/>
                <!-- Action buttons -->
                <Button fx:id="sendButton" text="Send" styleClass="send-button"/>
                <Button fx:id="sendImageButton" text="Image" styleClass="send-button"/>
            </HBox>
        </VBox>
    </VBox>
</VBox>
